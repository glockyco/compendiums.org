{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "compendiums-site",
  "compatibility_date": "2026-06-13",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "compendiums.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
